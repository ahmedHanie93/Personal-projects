@startuml
title Institutional Onboarding - Clean Architecture Flow

skinparam componentStyle rectangle
skinparam shadowing false

' ==== ENTRY ====
package "1. Client / Sales" {
  [1. Mandate Awarded (SFDC)] as SFDC
}

' ==== ORCHESTRATION ====
package "2. Orchestration (CAM / Workflow)" {
  [2. Initiate Onboarding & Assign CAM] as CAM
}

' ==== EXECUTION ====
package "3. Parallel Execution" {

  package "3A. Compliance" {
    [3.1 KYC / AML (Appway)] as KYC
    [3.2 Risk Approval] as RISK
  }

  package "3B. Legal" {
    [3.3 IMA Negotiation (Compose)] as IMA
    [3.4 Clause Library] as CLAUSE
  }

  package "3C. Operations" {
    [3.5 Account Setup (PANDA)] as ACCOUNT
    [3.6 Guidelines Setup (Beacon)] as GUIDELINES
  }

  package "3D. Supporting" {
    [3.7 Fee Setup (Revport)] as FEE
    [3.8 Reporting Setup (Synopsis)] as REPORT
  }
}

' ==== CONTROL GATE ====
package "4. Control Gate" {
  [4. IMA Sign-Off] as SIGNOFF
}

' ==== COMPLETION ====
package "5. Completion" {
  [5.1 Account Ready] as READY
  [5.2 Initial Funding] as FUNDING
  [5.3 Onboarding Complete (CRM Updated)] as COMPLETE
  [5.4 Post-Onboarding Review] as REVIEW
}

' ==== FLOW ====
SFDC --> CAM

CAM --> KYC
CAM --> IMA
CAM --> ACCOUNT

KYC --> RISK
RISK --> SIGNOFF

IMA --> CLAUSE
CLAUSE --> SIGNOFF

ACCOUNT --> GUIDELINES
GUIDELINES --> SIGNOFF

SIGNOFF --> FEE
SIGNOFF --> REPORT

SIGNOFF --> READY

READY --> FUNDING
FUNDING --> COMPLETE
COMPLETE --> REVIEW

' ==== NOTES ====
note right of CAM
(2) CAM orchestrates onboarding today.
Future: centralized workflow engine.
end note

note right of SIGNOFF
(4) Critical gate:
No funding without IMA sign-off.
end note

@enduml